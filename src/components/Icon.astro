 * Strokes reference the shared `#bgaiGrad` linear gradient that Layout.astro
 * renders once per page, so every icon picks up the brand gradient without
 * needing a mask image per icon (see `.icon-defs` in Layout.astro).
 */
export interface Props {
  name?: string;
  size?: number;
  class?: string;
}
const { name = 'default', size = 22, class: className = '' } = Astro.props;


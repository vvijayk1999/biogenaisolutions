const body = PATHS[name] ?? PATHS.default;
---
<svg
  class:list={['icon-svg', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="url(#bgaiGrad)"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={body}
/>

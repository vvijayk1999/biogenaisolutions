---
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';
import Icon from './Icon.astro';
import CardDeck from './CardDeck.astro';
import ContentBlocks from './ContentBlocks.astro';
import { getCollection } from 'astro:content';
import { getContent, formatDate, DEFAULT_LOCALE, type Locale } from '../i18n';

export interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const c = getContent(locale);

// News in this locale, falling back to default-locale posts if none exist yet.
const published = await getCollection('news', ({ data }) => !data.draft);
let news = published.filter((p) => (p.data.lang ?? DEFAULT_LOCALE) === locale);
if (news.length === 0) news = published.filter((p) => (p.data.lang ?? DEFAULT_LOCALE) === DEFAULT_LOCALE);
news = news.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Locale bundles are seeded from English and may lag behind a structural
// change, so every optional card field is read defensively.
const list = (v: unknown): string[] => (Array.isArray(v) ? (v as string[]) : []);
const solutions = list(c.solutions?.items) as any[];
const services = list(c.services?.items) as any[];
const partners = list((c as any).partners?.items) as any[];
const solutionsIntro = (c.solutions as any)?.intro;
const researchIntro = (c.research as any)?.intro;
const researchSeries = ((c.research as any)?.series ?? {}) as any;
const researchPapers = list((c.research as any)?.papers) as any[];
const newsIntro = (c.news as any)?.intro;
const partnersContent = (c as any).partners ?? {};
const partnersIntro = partnersContent.intro;
// One story is lifted into the large card at the top; the rest fill the grid.
const featuredPost = news.find((p) => p.data.featured) ?? news[0];
const restPosts = news.filter((p) => p.id !== featuredPost?.id);
const servicesIntro = (c.services as any)?.intro;
---

<Navbar locale={locale} />

<main>
  <!-- HERO -->
  <section class="hero" id="home">
    <div class="hero-bg" aria-hidden="true" style="background-image: url('/hero-bg.png'); background-size: cover; background-position: center;"></div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="eyebrow">{c.hero.eyebrow}</span>
        <h1 class="hero-title">
          {c.hero.titleLead} <span class="gradient-text">{c.hero.titleHighlight}</span> {c.hero.titleTrail}
        </h1>
        <p class="hero-sub">{c.hero.subtitle}</p>
        <div class="hero-cta">
          <a href="#contact" class="btn btn-gradient">{c.hero.ctaPrimaryLabel}</a>
          <a href="#solutions" class="btn btn-ghost">{c.hero.ctaSecondaryLabel}</a>
        </div>
        <!-- <ul class="hero-trust">
          {c.hero.stats.map((s) => (<li><strong>{s.value}</strong> {s.label}</li>))}
        </ul> -->
      </div>

      <div class="hero-visual" aria-hidden="true">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
        <div class="hero-card">
          <img src="/logo-white.png" alt="" class="hero-logo" />
          <div class="hero-card-glow"></div>
          <div class="hero-tags">
            {c.hero.tags.map((t) => <span>{t}</span>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SOLUTIONS -->
  <section class="section section-split" id="solutions">
    <div class="container capabilities-container">
      <div class="strip-label">{c.ui.capabilitiesLabel}</div>
      <div class="marquee-wrapper">
        <div class="marquee-track">
          <ul class="strip-items">
            {c.general.capabilities.map((cap) => <li>{cap}</li>)}
          </ul>
          <ul class="strip-items" aria-hidden="true">
            {c.general.capabilities.map((cap) => <li>{cap}</li>)}
          </ul>
          <ul class="strip-items" aria-hidden="true">
            {c.general.capabilities.map((cap) => <li>{cap}</li>)}
          </ul>
        </div>
      </div>
    </div>

    <div class="split-top-bg" style="background-image: url('/solutions-bg.png');">
      <div class="split-top-overlay" aria-hidden="true"></div>
      <div class="container split-header-container">
        <div class="section-head">
          {c.solutions.eyebrow && <span class="eyebrow split-eyebrow">{c.solutions.eyebrow}</span>}
          <h2 class="section-title split-title">{c.solutions.heading}</h2>
          <p class="section-lead split-lead">{c.solutions.lead}</p>
        </div>

        {solutionsIntro && (
          <div class="split-intro">
            <ContentBlocks blocks={solutionsIntro.blocks} class="split-intro-blocks" />
          </div>
        )}
      </div>
    </div>

    <div class="split-bottom-content deck-content">
      <div class="container">
        <CardDeck items={solutions} idPrefix="solution" label={c.solutions.heading} />
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section section-split" id="services">
    <div class="split-top-bg" style="background-image: url('/capabilities-bg.png');">
      <div class="split-top-overlay" aria-hidden="true"></div>
      <div class="container split-header-container">
        <div class="section-head">
          {c.services.eyebrow && <span class="eyebrow split-eyebrow">{c.services.eyebrow}</span>}
          <h2 class="section-title split-title">{c.services.heading}</h2>
          <p class="section-lead split-lead">{c.services.lead}</p>
        </div>

        {servicesIntro && (
          <div class="split-intro">
            <ContentBlocks blocks={servicesIntro.blocks} class="split-intro-blocks" />
          </div>
        )}
      </div>
    </div>

    <div class="split-bottom-content deck-content">
      <div class="container">
        <CardDeck items={services} idPrefix="service" label={c.services.heading} />
      </div>
    </div>
  </section>

  <!-- VISION / MISSION / PHILOSOPHY -->
  <section class="section section-split" id="principles">
    <div class="split-top-bg" style="background-image: url('/what-drives-us-bg.png');">
      <div class="split-top-overlay" aria-hidden="true"></div>
      <div class="container split-header-container">
        <div class="section-head">
          <span class="eyebrow split-eyebrow">{c.principles.eyebrow}</span>
          <h2 class="section-title split-title">{c.principles.heading}</h2>
        </div>
      </div>
    </div>

    <div class="split-bottom-content">
      <div class="container">
        <div class="grid grid-3">
          <article class="pillar">
            <div class="pillar-bar"></div>
            <div class="card-head">
              <span class="card-icon"><Icon name="vision" size={24} /></span>
              <h3>{c.principles.visionLabel}</h3>
            </div>
            <p>{c.principles.vision}</p>
          </article>
          <article class="pillar">
            <div class="pillar-bar"></div>
            <div class="card-head">
              <span class="card-icon"><Icon name="mission" size={24} /></span>
              <h3>{c.principles.missionLabel}</h3>
            </div>
            <p>{c.principles.mission}</p>
          </article>
          <article class="pillar">
            <div class="pillar-bar"></div>
            <div class="card-head">
              <span class="card-icon"><Icon name="philosophy" size={24} /></span>
              <h3>{c.principles.philosophyLabel}</h3>
            </div>
            <p>{c.principles.philosophy}</p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- RESEARCH -->
  <section class="section section-split" id="research">
    <div class="split-top-bg" style="background-image: url('/research-bg.png');">
      <div class="split-top-overlay" aria-hidden="true"></div>
      <div class="container split-header-container">
        <div class="section-head">
          {c.research.eyebrow && <span class="eyebrow split-eyebrow">{c.research.eyebrow}</span>}
          <h2 class="section-title split-title">{c.research.heading}</h2>
          <p class="section-lead split-lead">{c.research.lead}</p>
        </div>

        {researchIntro && (
          <div class="split-intro">
            <ContentBlocks blocks={researchIntro.blocks} class="split-intro-blocks" />
          </div>
        )}
      </div>
    </div>

    <div class="split-bottom-content">
      <div class="container">
        <article class="card card-split research-series">
          <header class="card-aside">
            <span class="card-icon"><Icon name={researchSeries.icon ?? 'research'} size={28} /></span>
            {/* The title carries the link to the series itself, so the card
                needs no separate "read the paper" call to action. */}
            <h3>
              {researchSeries.url ? (
                <a href={researchSeries.url} target="_blank" rel="noopener noreferrer">{researchSeries.title}</a>
              ) : researchSeries.title}
            </h3>
            <p class="card-tagline">{researchSeries.subtitle}</p>
          </header>
          <div class="card-body">
            <ContentBlocks blocks={researchSeries.blocks} />
          </div>
        </article>

        <h3 class="papers-heading">{c.research.papersHeading}</h3>
        <ol class="papers-list">
          {researchPapers.map((paper) => (
            <li class="paper">
              <p class="paper-title">
                {paper.url ? (
                  <a href={paper.url} target="_blank" rel="noopener noreferrer">{paper.title}</a>
                ) : paper.title}
              </p>
              <p class="paper-credit">{paper.credit}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- NEWS -->
  <section class="section section-split section-alt" id="news">
    <div class="split-top-bg" style="background-image: url('/news-bg.png');">
      <div class="split-top-overlay" aria-hidden="true"></div>
      <div class="container split-header-container">
        <div class="section-head">
          {c.news.eyebrow && <span class="eyebrow split-eyebrow">{c.news.eyebrow}</span>}
          <h2 class="section-title split-title">{c.news.heading}</h2>
          <p class="section-lead split-lead">{c.news.lead}</p>
        </div>

        {newsIntro && (
          <div class="split-intro">
            <ContentBlocks blocks={newsIntro.blocks} class="split-intro-blocks" />
          </div>
        )}
      </div>
    </div>

    <div class="split-bottom-content">
      <div class="container">
        {news.length > 0 ? (
          <>
            {featuredPost && c.news.featuredHeading && (
              <h3 class="news-featured-heading">{c.news.featuredHeading}</h3>
            )}
            {featuredPost && (
              <article class="news-featured">
                <div class="news-featured-body">
                  <p class="news-meta">
                    <span class="news-featured-tag">{c.news.featuredTag}</span>
                    <span class="news-date">{formatDate(featuredPost.data.date, locale)}</span>
                  </p>
                  <h3>{featuredPost.data.title}</h3>
                  <p class="news-featured-summary">{featuredPost.data.summary}</p>
                  {featuredPost.data.category && <p class="news-category">{featuredPost.data.category}</p>}
                  <a class="research-link" href={`/news/${featuredPost.id}`}>{c.ui.readMore}
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                  </a>
                </div>
              </article>
            )}
            {restPosts.length > 0 && (
              <div class="news-grid">
                {restPosts.map((post) => (
                  <article class="news-card">
                    {post.data.thumbnail && (
                      <div class="news-card-media"><img src={post.data.thumbnail} alt={post.data.title} /></div>
                    )}
                    <div class="news-card-body">
                      <p class="news-meta">
                        {post.data.category && <span class="news-category">{post.data.category}</span>}
                        <span class="news-date">{formatDate(post.data.date, locale)}</span>
                      </p>
                      <h3>{post.data.title}</h3>
                      <p>{post.data.summary}</p>
                      <a class="research-link" href={`/news/${post.id}`}>{c.ui.readMore}
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                      </a>
                    </div>
                  </article>
                ))}
              </div>
            )}
          </>
        ) : (
          <div class="news-empty">
            <div class="news-empty-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h13a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2zM8 8h8M8 12h8M8 16h5"/></svg>
            </div>
            <h3>{c.ui.newsEmptyTitle}</h3>
            <p>{c.ui.newsEmptyText}</p>
            <a href="#contact" class="btn btn-outline">{c.ui.newsKeepUpdated}</a>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- PARTNERS -->
  {partners.length > 0 && (
    <section class="section section-split carousel-section" id="partners">
      {/* The whole section sits on the image overlay, not just a header band. */}
      <div class="split-top-bg partners-bg" style="background-image: url('/who-we-serve-bg.png');">
        <div class="split-top-overlay" aria-hidden="true"></div>
        <div class="container split-header-container partners-content">
          <div class="section-head partners-head">
            {partnersContent.eyebrow && <span class="eyebrow split-eyebrow">{partnersContent.eyebrow}</span>}
            <h2 class="section-title split-title">{partnersContent.heading}</h2>
            <p class="section-lead split-lead">{partnersContent.lead}</p>
          </div>

          {partnersIntro && (
            <div class="split-intro partners-intro">
              <ContentBlocks blocks={partnersIntro.blocks} class="split-intro-blocks" />
            </div>
          )}

          <div class="carousel carousel-single" data-carousel data-per-view="1">
            <button class="carousel-arrow carousel-prev" data-carousel-prev aria-label="Previous">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
            </button>
            <div class="carousel-viewport">
              <ul class="carousel-track" data-carousel-track>
                {partners.map((p, i) => (
                  <li class="carousel-slide">
                    <div class="carousel-card partner-card">
                      <span class="partner-index" aria-hidden="true">{i + 1}</span>
                      <div class="card-head">
                        <span class="card-icon"><Icon name={p.icon ?? 'partners'} size={26} /></span>
                        <h3>{p.name}</h3>
                      </div>
                      <p>{p.description}</p>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
            <button class="carousel-arrow carousel-next" data-carousel-next aria-label="Next">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
            </button>
          </div>
          <div class="carousel-dots" data-carousel-dots role="tablist" aria-label="Partners carousel navigation"></div>

          {partnersContent.closing && (
            <div class="partners-closing">
              <p>{partnersContent.closing}</p>
              {partnersContent.closingCta && (
                <a href="#contact" class="btn btn-gradient">{partnersContent.closingCta}</a>
              )}
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- ABOUT -->
  <section class="section section-split section-alt" id="about">
    <div class="split-top-bg" style="background-image: url('/about-bg.png');">
      <div class="split-top-overlay" aria-hidden="true"></div>
      <div class="container split-header-container">
        <div class="section-head">
          <span class="eyebrow split-eyebrow">{c.about.eyebrow}</span>
          <h2 class="section-title split-title">{c.about.heading}</h2>
        </div>
      </div>
    </div>

    <div class="split-bottom-content">
      <div class="container about-inner">
        <div class="about-copy">
          {c.about.paragraphs.map((p) => <p>{p}</p>)}
        <div class="founder">
          <div class="founder-avatar" aria-hidden="true">{c.about.founderInitials}</div>
          <div class="founder-info">
            <h3>{c.about.founderName}</h3>
            <p class="founder-role">{c.about.founderRole}</p>
            <p class="founder-bio">{c.about.founderBio}</p>
          </div>
        </div>
      </div>
      <aside class="about-stats">
        {c.about.stats.map((s) => (
          <div class="stat">
            <span class="stat-num gradient-text">{s.value}</span>
            <span class="stat-label">{s.label}</span>
          </div>
        ))}
      </aside>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="section section-split" id="contact">
    <div class="split-top-bg" style="background-image: url('/contact-bg.png');">
      <div class="split-top-overlay" aria-hidden="true"></div>
      <div class="container split-header-container">
        <div class="section-head">
          <span class="eyebrow split-eyebrow">{c.contact.eyebrow}</span>
        </div>
      </div>
    </div>

    <div class="split-bottom-content">
      <div class="container contact-inner">
        <div class="contact-copy">
          <h2 class="section-title">{c.contact.heading}</h2>
          <p class="section-lead">{c.contact.lead}</p>

          <p class="disclaimer">{c.contact.disclaimer}</p>
        </div>

      <form class="contact-form" id="contactForm" name="contact" method="post" {...(locale === 'en' ? { 'data-netlify': 'true', 'netlify-honeypot': 'bot-field' } : {})} novalidate>
        <input type="hidden" name="form-name" value="contact" />
        <p hidden>
          <label>Don't fill this out if you're human: <input name="bot-field" /></label>
        </p>
        <div class="form-row">
          <div class="field">
            <label for="firstName">{c.ui.form.firstName} <span class="req">*</span></label>
            <input type="text" id="firstName" name="First Name" required autocomplete="given-name" />
          </div>

          <div class="field">
            <label for="lastName">{c.ui.form.lastName} <span class="req">*</span></label>
            <input type="text" id="lastName" name="Last Name" required autocomplete="family-name" />
          </div>
        </div>

        <div class="field">
          <label for="email">{c.ui.form.email} <span class="req">*</span></label>
          <input type="email" id="email" name="Email" required autocomplete="email" />
        </div>

        <div class="field">
          <label for="jobTitle">{c.ui.form.jobTitle} <span class="req">*</span></label>
          <input type="text" id="jobTitle" name="Job Title" required autocomplete="organization-title" />
        </div>

        <div class="field">
          <label for="company">{c.ui.form.company} <span class="req">*</span></label>
          <input type="text" id="company" name="Company" required autocomplete="organization" />
        </div>

        <div class="field">
          <label for="interest">{c.ui.form.interest} <span class="req">*</span></label>
          <select id="interest" name="Interested In" required>
            <option value="" disabled selected>{c.ui.form.interestPlaceholder}</option>
            {c.contact.interests.map((i) => <option>{i}</option>)}
          </select>
        </div>

        <div class="field">
          <label for="comments">{c.ui.form.comments} <span class="req">*</span></label>
          <textarea id="comments" name="Comments" rows="5" required placeholder={c.ui.form.commentsPlaceholder}></textarea>
        </div>

        <div class="form-actions-row">
          <div class="recaptcha-note">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 4 5v6c0 5 3.4 8.5 8 11 4.6-2.5 8-6 8-11V5z"/><path d="m9 12 2 2 4-4"/></svg>
            {c.ui.form.recaptcha}
          </div>

          <button type="submit" class="btn btn-gradient">{c.ui.form.submit}</button>
        </div>

        <p class="form-error" id="formError" role="alert" hidden>{(c.ui.form as any).errorRequired ?? 'Please complete the required fields before submitting.'}</p>
        <p class="form-success" id="formSuccess" role="status" hidden>{c.ui.form.success}</p>
      </form>
    </div>
  </section>
</main>

<Footer locale={locale} />

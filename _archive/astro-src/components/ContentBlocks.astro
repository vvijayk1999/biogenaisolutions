---
import { inlineMarkdown } from '../lib/richtext';

/**
 * Renders a CMS-authored block list.
 *
 * Each block carries its own type, so the editor picks the treatment per
 * block and the card follows the source document's order exactly. Text
 * accepts inline markdown (bold / italic) — see lib/richtext.
 *
 *   paragraph  body copy
 *   highlight  the document's bold stand-alone lines ("A + B + C", a quoted
 *              question) — set apart in an accent panel
 *   bullets    one item per line, for entries that are full sentences
 *   numbered   the same, numbered — the documents' "1. … 2. …" lists
 *   bubbles    wrapping pills, for short labels
 *   flow       left-to-right arrow chain (A → B → C)
 *   steps      numbered pipeline; wraps, for chains too long for one row
 *   note       closing remark, divided off from the body above
 *   stages     named stages, each with its own copy and arrow chain
 */
export interface Props {
  blocks: any[];
  /** Extra class for the wrapper, so callers can scope their own spacing. */
  class?: string;
}
const { blocks, class: className } = Astro.props;

const list = (v: unknown): string[] => (Array.isArray(v) ? (v as string[]) : []);
const objs = (v: unknown): any[] => (Array.isArray(v) ? (v as any[]) : []);
const items = (b: any) => list(b.items).filter((s) => typeof s === 'string' && s.trim() !== '');
const longest = (v: string[]) => v.reduce((n, b) => Math.max(n, b.length), 0);

// Short bullet entries can run in columns — that is what keeps a 10-item
// card from pushing the carousel to twice the height. Multicol does not
// apply to a grid container, so the split variants go back to block flow.
const listClass = (v: string[]) => {
  if (v.length >= 8 && longest(v) <= 24) return 'card-list-split-3';
  if (v.length >= 6 && longest(v) <= 46) return 'card-list-split';
  return null;
};
const blockList = objs(blocks);
---
{blockList.length > 0 && (
  <div class:list={['blocks', className]}>
    {blockList.map((b) => {
      const type = typeof b?.type === 'string' ? b.type : 'paragraph';
      if (type === 'numbered') {
        const it = items(b);
        return it.length > 0 && (
          <ol class="card-numbered">
            {it.map((s) => <li set:html={inlineMarkdown(s)} />)}
          </ol>
        );
      }
      if (type === 'bullets') {
        const it = items(b);
        return it.length > 0 && (
          <ul class:list={['card-list', listClass(it)]}>
            {it.map((s) => <li set:html={inlineMarkdown(s)} />)}
          </ul>
        );
      }
      if (type === 'bubbles') {
        const it = items(b);
        return it.length > 0 && (
          <ul class="card-chips">
            {it.map((s) => <li set:html={inlineMarkdown(s)} />)}
          </ul>
        );
      }
      if (type === 'flow') {
        const it = items(b);
        return it.length > 0 && (
          <ol class="card-flow">
            {it.map((s) => <li set:html={inlineMarkdown(s)} />)}
          </ol>
        );
      }
      if (type === 'steps') {
        const it = items(b);
        return it.length > 0 && (
          <ol class="card-steps">
            {it.map((s) => <li set:html={inlineMarkdown(s)} />)}
          </ol>
        );
      }
      if (type === 'stages') {
        const st = objs(b.items);
        return st.length > 0 && (
          <div class="card-stages">
            {st.map((s) => (
              <div class="card-stage">
                <h4 set:html={inlineMarkdown(s.name)} />
                {s.text && <p set:html={inlineMarkdown(s.text)} />}
                {list(s.flow).length > 0 && (
                  <ol class="card-flow">
                    {list(s.flow).map((f) => <li set:html={inlineMarkdown(f)} />)}
                  </ol>
                )}
              </div>
            ))}
          </div>
        );
      }
      if (!b?.text) return null;
      if (type === 'highlight') return <p class="card-highlight" set:html={inlineMarkdown(b.text)} />;
      if (type === 'note') return <p class="card-note" set:html={inlineMarkdown(b.text)} />;
      return <p set:html={inlineMarkdown(b.text)} />;
    })}
  </div>
)}

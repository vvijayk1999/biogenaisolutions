---
import Icon from './Icon.astro';
import ContentBlocks from './ContentBlocks.astro';

/**
 * Flat carousel for long card sets (Solutions, Services).
 *
 * One card fills the viewport at a time and the track slides horizontally —
 * no perspective, rotation or scaling — so a 14-card section reads as one
 * screen instead of fourteen rows of scrolling. Behaviour lives in the
 * `initDeck` handler in Layout.astro, driven by the data-deck-* hooks.
 */
export interface Props {
  items: any[];
  idPrefix: string;
  label?: string;
}
const { items, idPrefix, label = 'Cards' } = Astro.props;
---
<div class="deck" data-deck aria-roledescription="carousel" aria-label={label}>
  <div class="deck-viewport">
    <button class="carousel-arrow deck-arrow deck-arrow-prev" data-deck-prev aria-label="Previous card">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
    </button>

    <div class="deck-window">
      <div class="deck-track" data-deck-stage>
        {items.map((item, i) => (
          <div class="deck-slide" data-deck-slide role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${items.length}`}>
            <article class="card card-split" id={`${idPrefix}-${i + 1}`} tabindex="-1">
              <header class="card-aside">
                <span class="card-icon"><Icon name={item.icon} size={28} /></span>
                <h3>{item.title}</h3>
                {item.tagline && <p class="card-tagline">{item.tagline}</p>}
              </header>
              <div class="card-body">
                <ContentBlocks blocks={item.blocks} />
              </div>
            </article>
          </div>
        ))}
      </div>
    </div>

    <button class="carousel-arrow deck-arrow deck-arrow-next" data-deck-next aria-label="Next card">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
    </button>
  </div>

  <div class="deck-footer">
    <div class="deck-dots" data-deck-dots role="tablist" aria-label={label}></div>
    <span class="deck-counter" data-deck-counter aria-live="polite"></span>
  </div>
</div>
